    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "^15.5.27",
    "nodemailer": "^10.0.15",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
