# Copy to .env and fill in. Never commit .env.

# Public address of the app, used in email links, passkeys and sign-in redirects.
APP_URL=http://localhost:3000
# Domain Caddy serves and gets a certificate for.
DOMAIN=localhost

# PostgreSQL has two roles: the owner, which applies migrations, and
# tshaeno_app, which the app uses and row-level security applies to.
# Long random values:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
# Only for running outside Docker (npm run dev, tests). Compose sets these itself.
DATABASE_URL=postgresql://tshaeno_app:change-me-too@localhost:5432/tshaeno
MIGRATE_DATABASE_URL=postgresql://tshaeno:change-me@localhost:5432/tshaeno
REDIS_URL=redis://localhost:6379

# Encrypts each person's authenticator secret. Exactly 32 random bytes, base64:
#   openssl rand -base64 32
# Keep a copy somewhere safe: if it is lost, everyone must set up their authenticator again.
TOTP_ENCRYPTION_KEY=

# Outgoing mail. Without SMTP_URL, development prints emails to the log
# and production refuses to send.
#   SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Tshaeno <no-reply@example.com>"

# Sign in with Google (optional). Google Cloud console, APIs and services,
# Credentials, Create credentials, OAuth client ID, Web application.
# Authorised redirect URI: https://YOUR-DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Microsoft (optional). Entra admin centre, App registrations,
# New registration, "Accounts in any organizational directory and personal
# Microsoft accounts". Redirect URI (Web): https://YOUR-DOMAIN/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Connecting customers' Google Workspace (optional). Google Cloud console:
# create a service account, enable the Admin SDK API and the Gmail API in
# its project, then create a JSON key. Paste the key file's contents here,
# as is or base64 encoded. Customers trust its client ID with domain-wide
# delegation; see docs/going-live.md, step 9.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Connecting customers' Microsoft 365 (optional). A multi-tenant Entra app
# with the application permissions User.Read.All and GroupMember.Read.All,
# and the redirect URI https://YOUR-DOMAIN/connect/microsoft/callback.
# Leave empty to use the sign-in app above, if it has those permissions.
MICROSOFT_DIRECTORY_CLIENT_ID=
MICROSOFT_DIRECTORY_CLIENT_SECRET=

# Billing. Card and mobile money payments go through DPO Pay once these two
# are set; until then customers pay by bank transfer and you record it in
# the admin area. Both come from your DPO merchant account.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
# Shown on every invoice for bank transfers. Separate lines with |
#   BANK_DETAILS="Bank: First National Bank Botswana|Account: 62000000000|Branch: 281467"
BANK_DETAILS=
# Your business name and address on invoices. Separate lines with |
INVOICE_ISSUER="Tshaeno"
# Tax added to invoices, in percent. 0 leaves it off.
TAX_PERCENT=0
TAX_LABEL=VAT
# Enterprise quote requests go here.
SALES_EMAIL=
# Where the "Signature by Tshaeno" link on free plans points.
WEBSITE_URL=https://tshaeno.com

# Sign in from the Fourth Generation console (optional). Register a
# confidential client there with the redirect URI
# https://YOUR-DOMAIN/auth/fourthgen/callback; see docs/going-live.md, step 11.
FOURTHGEN_OIDC_ISSUER=
FOURTHGEN_CLIENT_ID=
FOURTHGEN_CLIENT_SECRET=

# Claude (optional). Drafts signatures from a description and reviews
# published ones for brand consistency. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
