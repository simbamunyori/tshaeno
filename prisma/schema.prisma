// Tshaeno data model.
//
// Rules this schema encodes (see docs/architecture.md):
// - Every business row belongs to exactly one Organisation (the tenant)
//   and carries organisationId. PostgreSQL row-level security, set up in
//   the migrations, decides which rows a query can see or write.
// - People (User) and their sign-in methods are global: one person can
//   belong to several organisations with one sign-in.
// - AuditLog and PlatformAuditLog rows are never edited or deleted
//   (database triggers).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// The application's own role, which row-level security applies to.
  url       = env("DATABASE_URL")
  /// The owner role, used only to apply migrations.
  directUrl = env("MIGRATE_DATABASE_URL")
}

// ─── Tenancy ─────────────────────────────────────────────────────────

enum OrganisationStatus {
  ACTIVE
  /// Nobody in the organisation can use the app; nothing is deleted.
  SUSPENDED
}

model Organisation {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganisationStatus @default(ACTIVE)
  timeZone  String             @default("Africa/Gaborone")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  people       Person[]
  customFields CustomField[]
  assets       Asset[]
  brandKits    BrandKit[]
  templates    SignatureTemplate[]
  versions     SignatureVersion[]
  assignments  SignatureAssignment[]
  connections  DirectoryConnection[]
  deliveries   SignatureDelivery[]
  outlookAddin OutlookAddin?
}

enum Role {
  /// Everything, including members, billing and deleting the organisation.
  OWNER
  /// Everything except billing and the owners themselves.
  ADMIN
  /// Builds and assigns signature templates and brand kits.
  TEMPLATE_MANAGER
  /// Reads coverage and analytics.
  ANALYST
  /// Sees everything, changes nothing.
  READ_ONLY
}

model Membership {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           Role
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  sentInvitations Invitation[] @relation("invitedBy")

  @@unique([organisationId, userId])
  @@index([userId])
}

model Invitation {
  id             String    @id @default(cuid())
  organisationId String
  /// Stored lower-cased.
  email          String
  role           Role
  /// SHA-256 of the emailed link's token. Cleared once used.
  tokenHash      String?   @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  invitedBy    Membership   @relation("invitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organisationId])
}

/// One row per change made inside an organisation. Append-only.
model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  /// The person, when there is one. Platform staff acting on an
  /// organisation are recorded here with actorLabel "Tshaeno staff: <name>".
  actorUserId    String?
  actorLabel     String
  action         String
  entityType     String
  entityId       String
  data           Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, createdAt])
}

// ─── People and sign-in (global, not tenant data) ────────────────────

model User {
  id               String    @id @default(cuid())
  /// Stored lower-cased.
  email            String    @unique
  name             String
  /// scrypt hash. Null for people who only use Google, Microsoft or a passkey.
  passwordHash     String?
  emailVerifiedAt  DateTime?
  /// SHA-256 of the newest "confirm your email" link; cleared once used.
  emailTokenHash   String?   @unique
  emailTokenSentAt DateTime?
  /// AES-256-GCM encrypted TOTP secret; null until set up.
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  /// Last accepted TOTP time step, so a code can never be used twice.
  totpLastStep     Int?
  failedAttempts   Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// Tshaeno staff. Opens the platform admin area. Set by hand on the
  /// server (see docs/going-live.md), never from the app.
  isPlatformAdmin  Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships   Membership[]
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  identities    Identity[]
  passkeys      Passkey[]
}

enum IdentityProvider {
  GOOGLE
  MICROSOFT
}

/// A Google or Microsoft account linked to a person.
model Identity {
  id         String           @id @default(cuid())
  userId     String
  provider   IdentityProvider
  /// The provider's stable id: "sub" for Google, "oid" + "tid" for Microsoft.
  subject    String
  email      String
  createdAt  DateTime         @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  /// base64url credential id.
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  /// What the person called it, e.g. "MacBook" or "Phone".
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SessionStage {
  /// First factor accepted; waiting for the authenticator code.
  CODE_PENDING
  /// Signed in with a password but no second step yet; must set one up.
  SETUP_PENDING
  /// Fully signed in.
  ACTIVE
}

enum SignInMethod {
  PASSWORD
  GOOGLE
  MICROSOFT
  PASSKEY
}

/// A browser session. Only the SHA-256 hash of the cookie value is stored.
model Session {
  id                   String       @id @default(cuid())
  tokenHash            String       @unique
  userId               String
  stage                SessionStage
  method               SignInMethod
  activeOrganisationId String?
  expiresAt            DateTime
  lastSeenAt           DateTime     @default(now())
  revokedAt            DateTime?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use backup codes for when the phone is lost. Stored hashed.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A short-lived passkey challenge. The browser holds its id in a cookie.
model AuthChallenge {
  id        String   @id @default(cuid())
  /// "passkey-register" or "passkey-sign-in".
  purpose   String
  challenge String
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// What Tshaeno staff did in the platform admin area. Append-only.
model PlatformAuditLog {
  id                   String   @id @default(cuid())
  actorUserId          String
  actorLabel           String
  action               String
  targetOrganisationId String?
  data                 Json?
  ipAddress            String?
  createdAt            DateTime @default(now())

  @@index([createdAt])
}

// ─── Email ───────────────────────────────────────────────────────────

enum OutboundEmailStatus {
  PENDING
  SENT
  FAILED
}

/// Email waiting to go out. Written in the same transaction as the change
/// that causes it and sent by the worker after commit. Holds what to send,
/// not the rendered message, so links are made at send time.
model OutboundEmail {
  id        String              @id @default(cuid())
  kind      String
  toAddress String
  payload   Json
  status    OutboundEmailStatus @default(PENDING)
  attempts  Int                 @default(0)
  lastError String?
  sendAfter DateTime            @default(now())
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([status, sendAfter])
}

// ─── Signatures (milestone S2) ─────────────────────────────────────

enum PersonSource {
  MANUAL
  CSV
  GOOGLE
  MICROSOFT
}

/// Someone who gets a signature. Not necessarily a Tshaeno user.
model Person {
  id             String       @id @default(cuid())
  organisationId String
  email          String
  firstName      String
  lastName       String       @default("")
  title          String       @default("")
  department     String       @default("")
  phone          String       @default("")
  mobile         String       @default("")
  photoAssetId   String?
  /// Values for the organisation's custom fields, by key.
  custom         Json         @default("{}")
  source         PersonSource @default(MANUAL)
  /// The person's id in Google or Microsoft, once a directory sync has matched them.
  externalId     String?
  /// Group names or addresses from the directory, for signature rules.
  groups         String[]     @default([])
  location       String       @default("")
  active         Boolean      @default(true)
  syncedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  photo        Asset?                @relation(fields: [photoAssetId], references: [id], onDelete: SetNull)
  assignments  SignatureAssignment[]
  deliveries   SignatureDelivery[]

  @@unique([organisationId, email])
  @@index([organisationId, department])
  @@index([organisationId, source, externalId])
}

/// An extra directory attribute, used in signatures as {{custom.key}}.
model CustomField {
  id              String   @id @default(cuid())
  organisationId  String
  key             String
  label           String
  /// The directory attribute it is filled from on sync, such as
  /// "Employee.CostCentre" in Google or "extensionAttribute3" in Microsoft.
  sourceAttribute String?
  createdAt       DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, key])
}

enum AssetKind {
  LOGO
  PHOTO
  BANNER
  IMAGE
}

/// An uploaded image. Served publicly at /i/a/<id>, because email
/// clients fetch signature images without signing in; the id is random.
model Asset {
  id             String    @id
  organisationId String
  kind           AssetKind
  contentType    String
  width          Int
  height         Int
  size           Int
  sha256         String
  bytes          Bytes
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  people       Person[]
  brandKits    BrandKit[]

  @@index([organisationId, kind])
}

model BrandKit {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  isDefault      Boolean  @default(false)
  /// Colours, font, company details, disclaimer and social links.
  data           Json
  logoAssetId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  logo         Asset?              @relation(fields: [logoAssetId], references: [id], onDelete: SetNull)
  templates    SignatureTemplate[]

  @@index([organisationId])
}

enum TemplateKind {
  VISUAL
  HTML
}

model SignatureTemplate {
  id                 String       @id @default(cuid())
  organisationId     String
  name               String
  kind               TemplateKind
  brandKitId         String?
  /// The working copy: a studio document, or { html }.
  draft              Json
  /// The starter it was made from, if any.
  starterKey         String?
  publishedVersionId String?      @unique
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brandKit     BrandKit?             @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  versions     SignatureVersion[]    @relation("TemplateVersions")
  published    SignatureVersion?     @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  assignments  SignatureAssignment[]

  @@index([organisationId])
}

/// A published snapshot. People's signatures use the latest one.
model SignatureVersion {
  id             String       @id @default(cuid())
  organisationId String
  templateId     String
  number         Int
  kind           TemplateKind
  content        Json
  createdById    String?
  createdAt      DateTime     @default(now())

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  template     SignatureTemplate  @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  publishedOn  SignatureTemplate? @relation("PublishedVersion")

  @@unique([templateId, number])
}

enum AssignmentScope {
  EVERYONE
  LOCATION
  DEPARTMENT
  GROUP
  PERSON
}

/// Who an email is going to. Outlook can tell; Gmail signatures are fixed,
/// so Gmail always gets the signature for external email.
enum Audience {
  ANY
  INTERNAL
  EXTERNAL
}

/// Gives a template to everyone, a department or one person, for new
/// emails, replies, or both. The most specific rule wins.
model SignatureAssignment {
  id             String          @id @default(cuid())
  organisationId String
  templateId     String
  scope          AssignmentScope
  department     String?
  groupName      String?
  location       String?
  personId       String?
  forNew         Boolean         @default(true)
  forReply       Boolean         @default(true)
  audience       Audience        @default(ANY)
  createdAt      DateTime        @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  template     SignatureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  person       Person?           @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organisationId, templateId])
}

// ─── Connections and delivery ──────────────────────────────────────

enum ConnectionProvider {
  GOOGLE
  MICROSOFT
}

enum ConnectionStatus {
  /// Set up started, not yet proven to work.
  PENDING
  CONNECTED
  /// Worked before, now failing a check.
  ERROR
}

/// A link to the customer's Google Workspace or Microsoft 365. No customer
/// secrets are stored: Google trusts our service account through
/// domain-wide delegation, and Microsoft through admin consent.
model DirectoryConnection {
  id             String             @id @default(cuid())
  organisationId String
  provider       ConnectionProvider
  status         ConnectionStatus   @default(PENDING)
  /// Google: an administrator to act as when reading the directory.
  adminEmail     String?
  /// Microsoft: the tenant that granted consent.
  tenantId       String?
  /// Microsoft: the random state in the consent link, until it is used.
  consentState   String?            @unique
  /// Microsoft: the consent sign-in's nonce and PKCE verifier, kept here
  /// because the admin may open the link in another browser.
  consentFlow    Json?
  syncEnabled    Boolean            @default(true)
  /// Google: push signatures into Gmail.
  pushEnabled    Boolean            @default(true)
  /// The last health check: [{ key, ok, message }].
  health         Json               @default("[]")
  checkedAt      DateTime?
  lastSyncAt     DateTime?
  lastSyncResult Json?
  lastSyncError  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, provider])
}

enum DeliveryTarget {
  GMAIL
  OUTLOOK
}

enum DeliveryState {
  PENDING
  APPLIED
  FAILED
  SKIPPED
}

/// Whether one person's signature reached one mail client, and why not.
model SignatureDelivery {
  id             String         @id @default(cuid())
  organisationId String
  personId       String
  target         DeliveryTarget
  state          DeliveryState  @default(PENDING)
  templateId     String?
  /// sha256 of the HTML last applied, so unchanged signatures aren't pushed again.
  hash           String?
  attempts       Int            @default(0)
  /// A plain explanation of the last problem, for the coverage page.
  lastError      String?
  appliedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, target])
  @@index([organisationId, target, state])
}

/// The organisation's Outlook add-in. Its key is in the add-in's links,
/// so the add-in can ask for signatures without anyone signing in.
model OutlookAddin {
  id             String   @id @default(cuid())
  organisationId String   @unique
  key            String   @unique
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}
